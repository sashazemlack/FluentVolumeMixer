<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:FluentVolumeMixer.Helpers">

    <SolidColorBrush x:Key="AccentColorBrush" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="AccentColorLight" Color="#FF008EFF"/>
    <SolidColorBrush x:Key="AccentColorDark" Color="#FF006BBF"/>
    <SolidColorBrush x:Key="LightThemeTextBrush" Color="Black" />
    <SolidColorBrush x:Key="DarkThemeTextBrush" Color="White" />
    <SolidColorBrush x:Key="ControlDarkBackground" Color="#991B1B1B"/>
    <SolidColorBrush x:Key="ControlLightBackground" Color="#99BBBBBB"/>

    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Item.MouseOver.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Item.SelectedActive.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="Transparent"/>

    <SolidColorBrush x:Key="TextBox.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="Transparent"/>

    <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#99CACACA"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>

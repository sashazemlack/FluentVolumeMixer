    <SolidColorBrush x:Key="ScrollBar.Button.MouseOver.Background" Color="#FFD2D2D2"/>
    <SolidColorBrush x:Key="ScrollBar.Button.Pressed.Background" Color="#FF5D5D5D"/>

    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#FFFFFFFF"/>
    
    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="Transparent"/>

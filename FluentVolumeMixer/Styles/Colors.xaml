    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#FFBABABA"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Collapsed.Background" Color="#4CE9E9E9"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background" Color="#FFE9E9E9"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="#000000"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#FF8C8C8C"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="#FFE9E9E9"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="Transparent"/>

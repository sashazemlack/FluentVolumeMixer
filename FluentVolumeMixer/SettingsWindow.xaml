<Window x:Class="FluentVolumeMixer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:FluentVolumeMixer.Helpers"
        xmlns:local="clr-namespace:FluentVolumeMixer"
        mc:Ignorable="d"
        Title="Settings for Zemlackovs Fluent volume mixer"
        Background="{Binding Source={x:Static helpers:SettingsHelper.AppBackgroundLightTheme}, Converter={StaticResource PageBgConverter}}"
        Height="600" Width="800">

    <Window.Resources>
        
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <GroupBox Header="Windows 11 effects" Margin="8" Grid.Row="1">
            <StackPanel Orientation="Vertical">
                <RadioButton x:Name="Win11EffectNone" Content="None" Tag="1" GroupName="Win11EffectRb" Checked="EffectChecked_Checked" Margin="0,8,0,0"/>
                <RadioButton x:Name="Win11EffectMica" Content="Mica" IsEnabled="{Binding IsWin11}" Tag="2" GroupName="Win11EffectRb" Checked="EffectChecked_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="Win11EffectAcrylic" Content="Acrylic" IsEnabled="{Binding IsWin11}" Tag="3" GroupName="Win11EffectRb" Checked="EffectChecked_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="Win11EffectTabbed" Content="Tabbed" IsEnabled="{Binding IsWin11}" Tag="4" GroupName="Win11EffectRb" Checked="EffectChecked_Checked" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Windows 10 effects" Grid.Column="1" Grid.Row="1" Margin="8">
            <StackPanel Orientation="Vertical">
                <CheckBox x:Name="CbWin10Acrylic" Content="Windows 10 acrylic" Click="CbWin10Acrylic_Click" Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="App theme" Grid.Column="0" Grid.Row="0" Margin="8">
            <StackPanel Orientation="Vertical">
                <TextBlock Style="{StaticResource SubHeaderTextBlockStyle}" Text="Background"  Margin="0,4,0,2"/>
                <ComboBox x:Name="CboxAppThemeBg" SelectionChanged="CboxAppThemeBg_SelectionChanged">
                    <ComboBoxItem Content="Dark" Tag="0"/>
                    <ComboBoxItem Content="Light" Tag="1"/>
                </ComboBox>

                <TextBlock Style="{StaticResource SubHeaderTextBlockStyle}" Text="Texts and icons" Margin="0,8,0,2"/>
                <ComboBox x:Name="CboxAppThemeTexts" SelectionChanged="CboxAppThemeTexts_SelectionChanged">
                    <ComboBoxItem Content="Light" Tag="0"/>
                    <ComboBoxItem Content="Dark" Tag="1"/>
                </ComboBox>

                <TextBlock Style="{StaticResource SubHeaderTextBlockStyle}" Text="Icon on taskbar" Margin="0,8,0,2"/>
                <ComboBox x:Name="CboxAppThemeTrayIcon" SelectionChanged="CboxAppThemeTrayIcon_SelectionChanged">
                    <ComboBoxItem Content="White" Tag="0"/>
                    <ComboBoxItem Content="Black" Tag="1"/>
                </ComboBox>

                <CheckBox x:Name="CbTextFog" Content="Text fog" Click="CbTextFog_Click" Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Column="1" Margin="8">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Resources/AboutIcon.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="Zemlackovs Fluent volume mixer" Style="{StaticResource HeaderTextBlockStyle}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="Ver.: 1.4" Style="{StaticResource SubHeaderTextBlockStyle}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
